# Plantilla de variables de entorno para AIassistant
#
# CÓMO USARLO
#   1. Copiá este archivo y renombrá la copia a ".env"
#   2. Completá cada valor siguiendo los comentarios
#   3. NUNCA subas el archivo ".env" al repositorio (ya está bloqueado en .gitignore)
#
# Este archivo (.env.example) SÍ se sube, porque no tiene valores reales.
# Sirve para que cualquiera sepa qué variables necesita configurar.


# --- IA: Google Gemini ---------------------------------------------------
# Clave de la API de Gemini, usada por el módulo de IA para analizar las fotos
# de una publicación y para el chat del asistente.
# Dónde se obtiene: https://aistudio.google.com/apikey
# IMPORTANTE: esta clave se usa SOLO en el backend. Nunca en el frontend.
#
# HACE FALTA desde el Sprint 2. Sin ella el backend arranca igual y todo el
# flujo de publicaciones funciona, pero el asistente avisa que no está
# configurado en vez de responder.
GEMINI_API_KEY=

# --- Cuánto se puede gastar en IA --------------------------------------
# Los tres frenos del consumo del asistente y del análisis de fotos. Las tres
# son OPCIONALES: vacías, valen los números de abajo, que son los que están
# escritos en config/env.ts.
#
# Cortan ANTES de llamar a Gemini. El primero es por visitante —por usuario si
# tiene sesión, por dirección de IP si no— y el segundo es el techo de todo el
# servidor por día, que es el que se compara contra la cuota de Google.
#
# Subilos para una demostración; bajalos si la cuota queda corta.
IA_LIMITE_VISITANTE=12
IA_VENTANA_MINUTOS=5
IA_LIMITE_DIARIO=120


# Qué modelo de Gemini usar. Si la dejás vacía usa uno de la familia Flash con
# capacidad de visión, que es lo apropiado para el prototipo.
# Solo hay que tocarla si Google publica un modelo nuevo que convenga probar.
GEMINI_MODEL=


# --- Base de datos, fotos y login: Supabase ------------------------------
# Todas estas se obtienen en el panel de Supabase:
#   tu proyecto > Settings > API

# URL del proyecto. Se ve así: https://xxxxxxxxxxxx.supabase.co
# OBLIGATORIA. Sin esto no arranca ni el backend ni el frontend.
SUPABASE_URL=

# Clave pública ("anon" / "public"). Es la que usa el frontend.
# Está pensada para ser visible; los permisos se controlan desde Supabase
# con las reglas de acceso (RLS) definidas en supabase/migrations/.
# OBLIGATORIA.
SUPABASE_ANON_KEY=

# Clave de servicio ("service_role"). Tiene permisos totales sobre la base y
# se saltea todas las reglas de acceso.
# PELIGRO: solo en el backend. Si se filtra, alguien puede leer y borrar todo.
#
# HACE FALTA desde el Sprint 2, con UN SOLO USO en todo el proyecto: guardar
# los análisis de IA. Esa tabla no acepta escrituras de ningún usuario, para
# que nadie pueda inventarse el análisis de su propio aviso. Todo lo demás
# sigue trabajando con la identidad real de cada usuario.
SUPABASE_SERVICE_KEY=


# --- Servidor ------------------------------------------------------------
# Puerto en el que escucha el backend durante el desarrollo local.
# Si lo dejás vacío, usa 4000.
PORT=4000

# Dirección del backend, para que el frontend sepa a dónde llamar.
# Si lo dejás vacío, usa http://localhost:4000
API_URL=

# Dirección del frontend, para que el backend le acepte los pedidos.
# Si lo dejás vacío, usa http://localhost:3000
FRONTEND_URL=
