# Plantilla de variables de entorno para AIassistant
#
# CÓMO USARLO
#   1. Copiá este archivo y renombrá la copia a ".env"
#   2. Completá cada valor siguiendo los comentarios
#   3. NUNCA subas el archivo ".env" al repositorio (ya está bloqueado en .gitignore)
#
# Este archivo (.env.example) SÍ se sube, porque no tiene valores reales.
# Sirve para que cualquiera sepa qué variables necesita configurar.


# --- IA: Google Gemini ---------------------------------------------------
# Clave de la API de Gemini, usada por el módulo de IA para analizar fotos
# y estimar precios.
# Dónde se obtiene: https://aistudio.google.com/apikey
# IMPORTANTE: esta clave se usa SOLO en el backend. Nunca en el frontend.
GEMINI_API_KEY=


# --- Base de datos, fotos y login: Supabase ------------------------------
# Todas estas se obtienen en el panel de Supabase:
#   tu proyecto > Settings > API

# URL del proyecto. Se ve así: https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Clave pública ("anon" / "public"). Es la que puede usar el frontend.
# Está pensada para ser visible; los permisos se controlan desde Supabase.
SUPABASE_ANON_KEY=

# Clave de servicio ("service_role"). Tiene permisos totales sobre la base.
# PELIGRO: solo en el backend. Si se filtra, alguien puede leer y borrar todo.
SUPABASE_SERVICE_KEY=


# --- Servidor ------------------------------------------------------------
# Puerto en el que escucha el backend durante el desarrollo local.
# Valor sugerido: 4000
PORT=
