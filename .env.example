# Plantilla de variables de entorno para AIassistant
#
# CÓMO USARLO
#   1. Copiá este archivo y renombrá la copia a ".env"
#   2. Completá cada valor siguiendo los comentarios
#   3. NUNCA subas el archivo ".env" al repositorio (ya está bloqueado en .gitignore)
#
# Este archivo (.env.example) SÍ se sube, porque no tiene valores reales.
# Sirve para que cualquiera sepa qué variables necesita configurar.


# --- IA: Google Gemini ---------------------------------------------------
# Clave de la API de Gemini, usada por el módulo de IA para analizar fotos
# y estimar precios.
# Dónde se obtiene: https://aistudio.google.com/apikey
# IMPORTANTE: esta clave se usa SOLO en el backend. Nunca en el frontend.
#
# NO hace falta todavía: la IA se conecta recién en el Sprint 2.
# Podés dejarla vacía y la aplicación arranca igual.
GEMINI_API_KEY=


# --- Base de datos, fotos y login: Supabase ------------------------------
# Todas estas se obtienen en el panel de Supabase:
#   tu proyecto > Settings > API

# URL del proyecto. Se ve así: https://xxxxxxxxxxxx.supabase.co
# OBLIGATORIA. Sin esto no arranca ni el backend ni el frontend.
SUPABASE_URL=

# Clave pública ("anon" / "public"). Es la que usa el frontend.
# Está pensada para ser visible; los permisos se controlan desde Supabase
# con las reglas de acceso (RLS) definidas en supabase/migrations/.
# OBLIGATORIA.
SUPABASE_ANON_KEY=

# Clave de servicio ("service_role"). Tiene permisos totales sobre la base y
# se saltea todas las reglas de acceso.
# PELIGRO: solo en el backend. Si se filtra, alguien puede leer y borrar todo.
#
# NO hace falta todavía: en el Sprint 1 el backend trabaja con la identidad
# real de cada usuario, justamente para que las reglas de la base se apliquen.
SUPABASE_SERVICE_KEY=


# --- Servidor ------------------------------------------------------------
# Puerto en el que escucha el backend durante el desarrollo local.
# Si lo dejás vacío, usa 4000.
PORT=4000

# Dirección del backend, para que el frontend sepa a dónde llamar.
# Si lo dejás vacío, usa http://localhost:4000
API_URL=

# Dirección del frontend, para que el backend le acepte los pedidos.
# Si lo dejás vacío, usa http://localhost:3000
FRONTEND_URL=
